---
// SSR (prerender=false) → protégée par le middleware d'auth comme le reste de /admin.
// Une page statique échapperait au middleware (servie par le CDN).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
// Rendu des fichiers Markdown existants (source unique de vérité — pas de duplication).
import * as projectDoc from '../../../docs/documentation-projet.md';
import * as backOfficeDoc from '../../../docs/back-office.md';
---

<BaseLayout title="Documentation — Back-office Wivoo">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center gap-4">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-800 transition-colors">← Retour</a>
      <span class="text-sm font-semibold text-gray-700 border-l border-gray-200 pl-4">Documentation du projet</span>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-8">
    <!-- Onglets -->
    <div class="flex gap-1 mb-8 border-b border-gray-200">
      <button id="tab-projet" class="doc-tab active" data-target="doc-projet">Documentation projet</button>
      <button id="tab-bo" class="doc-tab" data-target="doc-bo">Back-office (exploitation)</button>
    </div>

    <article id="doc-projet" class="doc-prose"><projectDoc.Content /></article>
    <article id="doc-bo" class="doc-prose" style="display:none"><backOfficeDoc.Content /></article>
  </main>

  <style is:global>
    /* Onglets */
    .doc-tab {
      padding: 0.5rem 1rem; font-size: 0.875rem; font-weight: 600; color: #6b7280;
      border-bottom: 2px solid transparent; margin-bottom: -1px; cursor: pointer;
      background: none; transition: color .15s, border-color .15s;
    }
    .doc-tab:hover { color: #374151; }
    .doc-tab.active { color: #111827; border-bottom-color: #111827; }

    /* Prose — styles limités à .doc-prose (ne fuient pas au reste de l'app) */
    .doc-prose { color: #374151; font-size: 0.95rem; line-height: 1.65; }
    .doc-prose h1 { font-size: 1.6rem; font-weight: 800; color: #111827; margin: 0 0 1rem; }
    .doc-prose h2 { font-size: 1.2rem; font-weight: 700; color: #111827; margin: 2rem 0 0.75rem; padding-bottom: 0.35rem; border-bottom: 1px solid #f3f4f6; }
    .doc-prose h3 { font-size: 1rem; font-weight: 700; color: #111827; margin: 1.5rem 0 0.5rem; }
    .doc-prose p { margin: 0 0 0.85rem; }
    .doc-prose ul, .doc-prose ol { margin: 0 0 0.85rem; padding-left: 1.3rem; }
    .doc-prose ul { list-style: disc; }
    .doc-prose ol { list-style: decimal; }
    .doc-prose li { margin: 0.2rem 0; }
    .doc-prose a { color: #2563eb; text-decoration: underline; }
    .doc-prose strong { font-weight: 700; color: #111827; }
    .doc-prose code { background: #f3f4f6; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.85em; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .doc-prose pre { background: #0f172a; color: #e2e8f0; padding: 1rem; border-radius: 10px; overflow-x: auto; margin: 0 0 1rem; font-size: 0.78rem; line-height: 1.45; }
    .doc-prose pre code { background: none; padding: 0; color: inherit; font-size: inherit; }
    .doc-prose blockquote { border-left: 3px solid #d1d5db; padding: 0.25rem 0 0.25rem 1rem; margin: 0 0 1rem; color: #6b7280; }
    .doc-prose blockquote p { margin: 0.25rem 0; }
    .doc-prose hr { border: none; border-top: 1px solid #e5e7eb; margin: 2rem 0; }
    .doc-prose table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin: 0 0 1rem; display: block; overflow-x: auto; }
    .doc-prose th, .doc-prose td { border: 1px solid #e5e7eb; padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
    .doc-prose th { background: #f9fafb; font-weight: 600; color: #111827; white-space: nowrap; }
  </style>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.doc-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        tabs.forEach((t) => t.classList.toggle('active', t === tab));
        document.querySelectorAll<HTMLElement>('article.doc-prose').forEach((a) => {
          a.style.display = a.id === target ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
