---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readCases, SECTOR_COLORS } from '../../lib/cases';
import { analyticsEnabled, mget, pfcount, KEY_VIEWS, KEY_VISITORS, KEY_CLICKS_TOTAL, keyCaseClicks } from '../../lib/analytics';

const cases = readCases();
const enabled = analyticsEnabled();

let views = 0;
let uniques = 0;
let clicksTotal = 0;
let perCase: { slug: string; title: string; sector: string; clicks: number }[] = [];

if (enabled) {
  const keys = [KEY_VIEWS, KEY_CLICKS_TOTAL, ...cases.map((c) => keyCaseClicks(c.slug))];
  const vals = await mget(keys);
  views = Number(vals[0]) || 0;
  clicksTotal = Number(vals[1]) || 0;
  uniques = await pfcount(KEY_VISITORS);
  perCase = cases
    .map((c, i) => ({ slug: c.slug, title: c.title, sector: c.sector, clicks: Number(vals[i + 2]) || 0 }))
    .sort((a, b) => b.clicks - a.clicks);
}

const ctr = views > 0 ? (clicksTotal / views) * 100 : 0;
const maxClicks = Math.max(1, ...perCase.map((p) => p.clicks));
const hasData = views > 0 || clicksTotal > 0;
---

<BaseLayout title="Reporting — Back-office Wivoo">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center gap-4">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-800 transition-colors">← Retour</a>
      <span class="text-sm font-semibold text-gray-700 border-l border-gray-200 pl-4">Reporting</span>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Reporting</h1>
      <p class="text-sm text-gray-500 mt-1">Fréquentation et engagement sur les réalisations. Chiffres agrégés, indicatifs (sans filtrage des robots).</p>
    </div>

    {!enabled ? (
      <div class="bg-amber-50 border border-amber-200 text-amber-800 text-sm px-4 py-3 rounded-lg">
        ⚠ Analytics non configurée. Provisionnez <strong>Upstash Redis</strong> dans Vercel (onglet Storage / Marketplace) et connectez-le au projet : le suivi s'activera automatiquement.
      </div>
    ) : (
      <>
        <!-- Cartes de stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-3xl font-extrabold text-gray-900">{views.toLocaleString('fr-FR')}</p>
            <p class="text-sm text-gray-500 mt-1">Visites <span class="text-gray-400">(vues totales)</span></p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-3xl font-extrabold text-gray-900">{uniques.toLocaleString('fr-FR')}</p>
            <p class="text-sm text-gray-500 mt-1">Visiteurs uniques <span class="text-gray-400">(estimé)</span></p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-3xl font-extrabold text-gray-900">{clicksTotal.toLocaleString('fr-FR')}</p>
            <p class="text-sm text-gray-500 mt-1">Clics sur les réalisations</p>
          </div>
          <div class="bg-white rounded-2xl border border-gray-200 p-6">
            <p class="text-3xl font-extrabold text-gray-900">{ctr.toFixed(1)}%</p>
            <p class="text-sm text-gray-500 mt-1">Taux de clic (clics / visites)</p>
          </div>
        </div>

        {!hasData && (
          <div class="bg-gray-50 border border-gray-200 text-gray-500 text-sm px-4 py-3 rounded-lg mb-8">
            Aucune donnée pour l'instant — les compteurs se rempliront avec les visites.
          </div>
        )}

        <!-- Classement par réalisation -->
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Clics par réalisation</h2>
        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
          {perCase.map((p, i) => {
            const color = SECTOR_COLORS[p.sector]?.hex ?? '#111827';
            const pct = Math.round((p.clicks / maxClicks) * 100);
            return (
              <div class="flex items-center gap-4 px-5 py-3 border-b border-gray-100 last:border-b-0">
                <span class="text-sm font-bold text-gray-400 w-5 text-right">{i + 1}</span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-800 truncate">{p.title}</p>
                  <div class="mt-1.5 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-full rounded-full" style={`width:${pct}%; background-color:${color};`}></div>
                  </div>
                </div>
                <span class="text-sm font-bold text-gray-900 w-12 text-right">{p.clicks.toLocaleString('fr-FR')}</span>
              </div>
            );
          })}
        </div>
      </>
    )}
  </main>
</BaseLayout>
