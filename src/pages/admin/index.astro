---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { readCasesLive, writeCases, isRemotePersistence, ConcurrentEditError, SECTOR_COLORS } from '../../lib/cases';

// Handle POST (delete + toggle)
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action') as string;
  const slug   = form.get('slug') as string;
  const cases  = await readCasesLive();

  try {
    if (action === 'delete') {
      await writeCases(cases.filter(c => c.slug !== slug));
    } else if (action === 'toggle') {
      const c = cases.find(x => x.slug === slug);
      if (c) { c.published = !c.published; await writeCases(cases); }
    }
    return Astro.redirect('/admin?saved=1');
  } catch (e) {
    const code = e instanceof ConcurrentEditError ? 'conflict' : '1';
    return Astro.redirect(`/admin?error=${code}`);
  }
}

const cases = await readCasesLive();
const remote = isRemotePersistence();
const params = Astro.url.searchParams;
const flashSaved = params.get('saved') === '1';
const flashError = params.get('error'); // 'conflict' | '1' | null
---

<BaseLayout title="Back-office — Wivoo Réalisations">
  <style>
    .toast { animation: slideIn 0.3s ease; }
    @keyframes slideIn { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  </style>

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/">
          <img src="https://cdn.prod.website-files.com/64f8703aba9a3b126e920e3a/6867e403657af2e53b357217_LOGO-Wivoo-RGB_BLUE.svg"
               alt="Wivoo" class="h-10" />
        </a>
        <span class="text-sm font-semibold text-gray-500 border-l border-gray-200 pl-4">Back-office Réalisations</span>
      </div>
      <a href="/" target="_blank" class="text-sm text-gray-500 hover:text-gray-800 transition-colors">
        Voir le site →
      </a>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-8" data-remote={remote ? '1' : '0'}>
    {flashSaved && (
      <div class="mb-4 bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3 rounded-lg">
        ✓ Enregistré.{' '}
        {remote
          ? 'Le site public sera mis à jour dans ~1 minute (régénération automatique). La liste ci-dessous peut afficher l’ancien état le temps de la mise à jour.'
          : 'Modification appliquée localement.'}
      </div>
    )}
    {flashError === 'conflict' && (
      <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-800 text-sm px-4 py-3 rounded-lg">
        ⚠ Quelqu’un a modifié les réalisations en même temps que vous. Votre changement n’a pas été enregistré — rechargez la page et réessayez.
      </div>
    )}
    {flashError === '1' && (
      <div class="mb-4 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">
        ⚠ Une erreur est survenue lors de l’enregistrement. Réessayez dans un instant.
      </div>
    )}
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Réalisations</h1>
        <p class="text-sm text-gray-500 mt-1">
          {cases.length} réalisation{cases.length > 1 ? 's' : ''} ·{' '}
          {cases.filter(c => c.published !== false).length} publiée{cases.filter(c => c.published !== false).length > 1 ? 's' : ''}
        </p>
      </div>
      <a href="/admin/new"
         class="bg-gray-900 text-white font-semibold text-sm px-5 py-2.5 rounded-lg hover:bg-gray-700 transition-colors">
        + Nouvelle réalisation
      </a>
    </div>

    {cases.length === 0 ? (
      <div class="text-center py-20 text-gray-400 text-sm">
        Aucune réalisation. <a href="/admin/new" class="text-blue-600 hover:underline">Créez la première</a>.
      </div>
    ) : (
      <div class="space-y-3">
        {cases.map(c => {
          const color = SECTOR_COLORS[c.sector]?.hex ?? '#111827';
          const isPub = c.published !== false;
          return (
            <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
              <div class="w-16 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-gray-100">
                <img src={c.image} alt="" class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full text-white"
                        style={`background-color:${color}`}>{c.sector}</span>
                  {isPub
                    ? <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">Publié</span>
                    : <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Brouillon</span>
                  }
                </div>
                <p class="text-sm font-medium text-gray-800 truncate">{c.title}</p>
                <p class="text-xs text-gray-400 mt-0.5">{c.subtitle}</p>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <form method="POST" class="toggle-form" data-slug={c.slug}>
                  <input type="hidden" name="action" value="toggle" />
                  <input type="hidden" name="slug" value={c.slug} />
                  <button type="submit" data-toggle-btn
                          title="Mise à jour du site public en cours (~1 min)"
                          class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent">
                    {isPub ? '⊘ Dépublier' : '✓ Publier'}
                  </button>
                </form>
                <a href={`/admin/edit/${c.slug}`}
                   class="text-xs px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-gray-600 transition-colors">
                  Modifier
                </a>
                <form method="POST" onsubmit="return confirm('Supprimer définitivement cette réalisation ?')">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="slug" value={c.slug} />
                  <button type="submit"
                          class="text-xs px-3 py-1.5 rounded-lg border border-red-200 hover:bg-red-50 text-red-600 transition-colors">
                    Supprimer
                  </button>
                </form>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </main>

  <script>
    // Après un publier/dépublier, le site public met ~1 min à se régénérer
    // (rebuild Vercel). On désactive le bouton concerné pendant ce délai pour
    // éviter les re-clics qui empileraient des commits/redéploiements inutiles.
    // Le cooldown est stocké dans localStorage afin de survivre au rechargement
    // de page provoqué par le POST.
    // En local, l'écriture est instantanée (writeFileSync) et il n'y a pas de
    // rebuild Vercel : le cooldown n'a aucun sens et serait trompeur. On ne
    // l'active donc que lorsque la persistance est distante (prod).
    const IS_REMOTE = document.querySelector('main')?.dataset.remote === '1';

    const COOLDOWN_MS = 60000;
    const KEY = 'wivoo-admin-toggle-cooldown';

    function getCooldowns() {
      try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
    }
    function setCooldowns(obj) {
      localStorage.setItem(KEY, JSON.stringify(obj));
    }

    // Enregistre le cooldown au moment de la soumission (avant le rechargement).
    if (IS_REMOTE) {
      document.querySelectorAll('.toggle-form').forEach((form) => {
        form.addEventListener('submit', () => {
          const slug = form.dataset.slug;
          if (!slug) return;
          const cd = getCooldowns();
          cd[slug] = Date.now() + COOLDOWN_MS;
          setCooldowns(cd);
        });
      });
    }

    // Applique l'état (désactivé + compte à rebours) à chaque seconde.
    function applyCooldowns() {
      const cd = getCooldowns();
      const now = Date.now();
      let changed = false;

      document.querySelectorAll('.toggle-form').forEach((form) => {
        const slug = form.dataset.slug;
        const btn = form.querySelector('[data-toggle-btn]');
        if (!slug || !btn) return;

        const until = cd[slug];
        if (until && until > now) {
          const secs = Math.ceil((until - now) / 1000);
          if (!btn.dataset.original) btn.dataset.original = btn.textContent.trim();
          btn.disabled = true;
          btn.textContent = `⏳ Maj du site… ${secs}s`;
        } else {
          if (btn.disabled) {
            btn.disabled = false;
            if (btn.dataset.original) btn.textContent = btn.dataset.original;
          }
          if (until) { delete cd[slug]; changed = true; }
        }
      });

      if (changed) setCooldowns(cd);
    }

    if (IS_REMOTE) {
      applyCooldowns();
      setInterval(applyCooldowns, 1000);
    }
  </script>
</BaseLayout>
