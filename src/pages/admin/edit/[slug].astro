---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readCasesLive, writeCases, ConcurrentEditError } from '../../../lib/cases';
import type { Case } from '../../../lib/cases';

const { slug } = Astro.params;
const cases = await readCasesLive();
let c = cases.find(x => x.slug === slug);

if (!c) return Astro.redirect('/admin');

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const newSlug = (form.get('slug') as string).trim();

  if (newSlug !== slug && cases.find(x => x.slug === newSlug)) {
    error = `Le slug "${newSlug}" existe déjà.`;
  } else {
    const updated: Case = {
      id:          c.id,
      slug:        newSlug,
      sector:      form.get('sector') as Case['sector'],
      client:      (form.get('client') as string).trim(),
      title:       (form.get('title') as string).trim(),
      subtitle:    (form.get('subtitle') as string).trim(),
      description: (form.get('description') as string).trim(),
      image:       (form.get('image') as string).trim(),
      published:   form.get('published') === 'on',
      kpis: [0, 1, 2].map(i => ({
        value: (form.get(`kpi${i}_value`) as string || '').trim(),
        label: (form.get(`kpi${i}_label`) as string || '').trim(),
      })).filter(k => k.value || k.label),
      challenge: (form.get('challenge') as string).trim(),
      solution: (form.get('solution') as string).split('\n').map(s => s.trim()).filter(Boolean),
    };
    try {
      await writeCases(cases.map(x => x.slug === slug ? updated : x));
      return Astro.redirect('/admin?saved=1');
    } catch (e) {
      error = e instanceof ConcurrentEditError
        ? 'Quelqu’un a modifié les réalisations en même temps. Vos changements n’ont pas été enregistrés — rechargez la page et réessayez.'
        : 'Une erreur est survenue lors de l’enregistrement. Réessayez dans un instant.';
    }
  }
}
---

<BaseLayout title={`Modifier — ${c.title} — Back-office Wivoo`}>
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center gap-4">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-800 transition-colors">← Retour</a>
      <span class="text-sm font-semibold text-gray-700 border-l border-gray-200 pl-4">Modifier la réalisation</span>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-8 pb-20">
    {error && (
      <div class="mb-6 bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg">{error}</div>
    )}
    <form method="POST" class="space-y-6">
      <!-- Infos principales -->
      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Infos principales</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Secteur *</label>
            <select name="sector" required class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              {['Product','AI','Data','Design'].map(s => (
                <option value={s} selected={c!.sector === s}>{s}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Client (optionnel)</label>
            <input name="client" type="text" value={c.client} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Titre *</label>
          <input name="title" type="text" required value={c.title} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Slug URL *</label>
            <input name="slug" type="text" required value={c.slug} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Sous-titre / Direction</label>
            <input name="subtitle" type="text" value={c.subtitle} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Description courte (carte) *</label>
          <textarea name="description" required rows="2" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none">{c.description}</textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">URL de l'image *</label>
          <input name="image" type="url" required value={c.image} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div class="flex items-center gap-3">
          <input name="published" type="checkbox" id="pub" checked={c.published !== false} class="w-4 h-4 rounded" />
          <label for="pub" class="text-sm text-gray-600">Publié (visible sur le site vitrine)</label>
        </div>
      </div>

      <!-- KPIs -->
      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-3">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">KPIs</h2>
        {[0,1,2].map(i => (
          <div class="grid grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Valeur {i+1}</label>
              <input name={`kpi${i}_value`} type="text" value={c!.kpis[i]?.value ?? ''} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div class="col-span-2">
              <label class="block text-xs font-medium text-gray-500 mb-1">Label {i+1}</label>
              <input name={`kpi${i}_label`} type="text" value={c!.kpis[i]?.label ?? ''} class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
          </div>
        ))}
      </div>

      <!-- Contenu -->
      <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
        <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Contenu de la page détail</h2>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Le défi</label>
          <textarea name="challenge" rows="4" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none">{c.challenge}</textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Notre solution <span class="text-gray-400 font-normal">(une étape par ligne)</span></label>
          <textarea name="solution" rows="6" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none">{c.solution.join('\n')}</textarea>
        </div>
      </div>

      <div class="flex items-center gap-3 pb-8">
        <button type="submit" class="bg-[#5BDF6A] text-gray-900 font-semibold text-sm px-6 py-3 rounded-lg hover:opacity-90 transition-opacity">
          Enregistrer les modifications
        </button>
        <a href="/admin" class="text-sm px-6 py-3 rounded-lg border border-gray-200 hover:bg-gray-50 text-gray-600 transition-colors">
          Annuler
        </a>
      </div>
    </form>
  </main>
</BaseLayout>
