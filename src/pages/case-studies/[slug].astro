---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { readCases, SECTOR_COLORS, youtubeId } from '../../lib/cases';
import type { Case } from '../../lib/cases';

export const prerender = true;

export async function getStaticPaths() {
  const cases = readCases().filter(c => c.published !== false);
  return cases.map(c => ({ params: { slug: c.slug }, props: { c } }));
}

interface Props { c: Case; }
const { c } = Astro.props;
const col = SECTOR_COLORS[c.sector];
const videoId = youtubeId(c.videoUrl);
---

<BaseLayout title={`${c.title} — Wivoo`}>
  <Navbar backLink={true} />

  <!-- Hero -->
  <div class="relative w-full" style="aspect-ratio: 16/6; min-height: 320px;">
    <img src={c.image} alt="Hero" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 max-w-4xl mx-auto px-6 pb-10">
      <span class="inline-block text-xs font-semibold px-3 py-1 rounded-full text-white mb-4"
            style={`background-color: ${col.hex};`}>{c.sector}</span>
      <h1 class="text-white font-bold text-2xl md:text-4xl leading-snug">{c.title}</h1>
      <p class="text-white/70 text-sm mt-3">{c.subtitle}</p>
    </div>
  </div>

  <!-- Breadcrumb + Retour -->
  <div class="max-w-4xl mx-auto px-6 py-4 flex items-center gap-4">
    <a href="/"
       class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors shrink-0">
      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 12L6 8l4-4"/>
      </svg>
      Retour
    </a>
    <span class="text-gray-200">|</span>
    <p class="text-sm text-gray-400 truncate">
      <a href="/" class="hover:text-gray-700 transition-colors">Nos réalisations</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600">{c.title.substring(0, 60)}{c.title.length > 60 ? '…' : ''}</span>
    </p>
  </div>

  <!-- KPIs -->
  <section class="max-w-4xl mx-auto px-6 py-10">
    <h2 class="text-xl font-bold text-gray-900 mb-6">Principaux résultats</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {c.kpis.map(k => (
        <div class="rounded-2xl p-6 border" style={`background-color: ${col.bg}; border-color: ${col.hex}33;`}>
          <p class="text-4xl font-bold mb-2" style={`color: ${col.hex};`}>{k.value}</p>
          <p class="text-sm text-gray-600 leading-relaxed">{k.label}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6"><hr class="border-gray-100" /></div>

  <!-- Le défi -->
  <section class="max-w-4xl mx-auto px-6 py-10">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Le défi</h2>
    <p class="text-gray-600 leading-relaxed text-base">{c.challenge}</p>
  </section>

  <div class="max-w-4xl mx-auto px-6"><hr class="border-gray-100" /></div>

  <!-- Notre solution -->
  <section class="max-w-4xl mx-auto px-6 py-10">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Notre solution</h2>
    <ul class="space-y-3">
      {c.solution.map(s => (
        <li class="flex items-start gap-3">
          <span class="mt-1 w-2 h-2 rounded-full flex-shrink-0" style={`background-color: ${col.hex};`}></span>
          <span class="text-gray-600 text-base leading-relaxed">{s}</span>
        </li>
      ))}
    </ul>
  </section>

  {videoId && (
    <Fragment>
      <div class="max-w-4xl mx-auto px-6"><hr class="border-gray-100" /></div>
      <section class="max-w-4xl mx-auto px-6 py-10">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Découvrir en vidéo</h2>
        <YouTubeEmbed url={c.videoUrl} title={c.title} />
      </section>
    </Fragment>
  )}

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-6 py-12 text-center">
    <p class="text-gray-500 text-sm mb-4">Vous avez un projet similaire ?</p>
    <a href="https://www.wivoo.fr/contact" target="_blank"
       class="inline-block bg-[#5BDF6A] text-gray-900 font-bold text-sm px-8 py-4 rounded-full hover:opacity-90 transition-opacity">
      Prendre RDV
    </a>
  </section>

  <Footer />
</BaseLayout>
