---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { readCases, SECTOR_COLORS } from '../lib/cases';

export const prerender = true;

const cases = readCases().filter(c => c.published !== false);

const industries = [...new Set(
  cases.map(c => c.subtitle.includes('—') ? c.subtitle.split('—')[1].trim() : '').filter(Boolean)
)].sort();

const sectorCounts: Record<string, number> = {
  Product: cases.filter(c => c.sector === 'Product').length,
  AI:      cases.filter(c => c.sector === 'AI').length,
  Data:    cases.filter(c => c.sector === 'Data').length,
  Design:  cases.filter(c => c.sector === 'Design').length,
};

const industryLabels: Record<string, string> = {
  'Banques & Assurances': 'Banque',
  'Pharma / Santé': 'Santé',
};

const industryCounts: Record<string, number> = {};
cases.forEach(c => {
  const ind = c.subtitle.includes('—') ? c.subtitle.split('—')[1].trim() : '';
  if (ind) industryCounts[ind] = (industryCounts[ind] || 0) + 1;
});
---

<BaseLayout title="Nos Réalisations — Wivoo">
  <style>
    .case-card { transition: box-shadow .2s, transform .2s; }
    .case-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,.12); transform: translateY(-2px); }
    .case-card:hover .card-img img { transform: scale(1.04); }
    .card-img img { transition: transform .3s; }
    .card-title {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .kpi-label {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-cta { transition: gap .15s; }
    .case-card:hover .card-cta { gap: 8px; }

    /* Toggle */
    .toggle-btn { transition: background .15s, color .15s, box-shadow .15s; }
    .toggle-btn.active { background: #fff; color: #111827; box-shadow: 0 1px 3px rgba(0,0,0,.1); }

    /* List view */
    #grid.list-view {
      display: flex; flex-direction: column; gap: 0;
      background: #fff; border-radius: 16px; overflow: hidden;
      box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    #grid.list-view .case-card {
      display: grid;
      grid-template-columns: 220px minmax(0,1fr) 180px auto;
      align-items: center;
      gap: 16px;
      padding: 12px 16px;
      border-bottom: 1px solid #f3f4f6;
      border-radius: 0;
      box-shadow: none;
      transform: none;
    }
    #grid.list-view .case-card:last-child { border-bottom: none; }
    #grid.list-view .case-card:hover { background: #fafafa; box-shadow: none; transform: none; }
    #grid.list-view .card-img { aspect-ratio: 16/9 !important; border-radius: 8px; overflow: hidden; flex-shrink: 0; }
    #grid.list-view .card-img img { transform: none !important; }
    #grid.list-view .case-card:hover .card-img img { transform: none !important; }
    #grid.list-view .p-4 { padding: 0; display: contents; }
    #grid.list-view .card-titleblock { flex: unset; margin-bottom: 0; }
    #grid.list-view .card-title { -webkit-line-clamp: 3; flex: unset; margin-bottom: 0; }
    #grid.list-view .border-gray-100 { display: none; }
    #grid.list-view .kpi-group { display: flex; flex-direction: column; gap: 3px; justify-content: center; }
    #grid.list-view .text-2xl { font-size: 1.1rem; margin-bottom: 0; min-width: unset; text-align: left; }
    #grid.list-view .kpi-label { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.7rem; margin: 0; }
    #grid.list-view .card-cta { white-space: nowrap; margin-top: 0; }
  </style>

  <Navbar />

  <!-- Header -->
  <header class="w-full bg-[#f0eeff] pt-16 pb-14">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Nos Réalisations</h1>
      <p class="text-lg text-gray-500 max-w-xl mx-auto">
        Découvrez comment nous aidons nos clients à créer de la valeur grâce au Product, à l'IA, à la Data et au Design.
      </p>
    </div>
  </header>

  <!-- FilterBar + Toggle — sticky sous la navbar -->
  <div class="w-full bg-white border-b border-gray-100 sticky top-24 z-40"
       style="box-shadow: 0 4px 12px rgba(0,0,0,.06);">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-2.5">

      <!-- Ligne 1 : Expertise -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold tracking-widest text-gray-500 uppercase shrink-0" style="width:96px;">Expertise</span>
        <button id="btn-tous-sector"
          class="px-4 py-1.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 cursor-pointer"
          style="background-color:#111827; color:#fff; border-color:#111827;">
          Tous · 4
        </button>
        {(['Product', 'AI', 'Data', 'Design'] as const).map(s => (
          <button data-filter={s}
            class="filter-btn-sector px-4 py-1.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 cursor-pointer"
            style={`background-color:#fff; color:${SECTOR_COLORS[s].hex}; border-color:${SECTOR_COLORS[s].hex};`}>
            {s} · {sectorCounts[s]}
          </button>
        ))}
      </div>

      <!-- Ligne 2 : Secteur + résultats + toggle -->
      <div class="flex items-center gap-2 flex-nowrap">
        <span class="text-xs font-semibold tracking-widest text-gray-500 uppercase shrink-0" style="width:96px;">Secteur</span>
        <button id="btn-tous-industry"
          class="shrink-0 px-4 py-1.5 rounded-full text-sm font-semibold border-2 transition-all duration-200 cursor-pointer"
          style="background-color:#111827; color:#fff; border-color:#111827;">
          Tous · {industries.length}
        </button>
        {industries.map(ind => (
          <button data-filter={ind}
            class="filter-btn-industry shrink-0 px-3 py-1.5 rounded-full text-sm font-semibold border transition-all duration-200 cursor-pointer"
            style="background-color:#fff; color:#6b7280; border-color:#e5e7eb;">
            {industryLabels[ind] ?? ind} · {industryCounts[ind]}
          </button>
        ))}

        <!-- Résultats + toggle (droite) -->
        <div class="ml-auto flex items-center gap-3 shrink-0">
          <span id="result-count" class="text-sm font-bold text-gray-800">{cases.length} résultats</span>
          <div class="flex gap-0.5 bg-gray-200 rounded-lg p-1">
            <button id="btn-grid" class="toggle-btn active w-7 h-7 rounded-md flex items-center justify-center text-gray-500 cursor-pointer" title="Vue grille">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor">
                <rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/>
                <rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/>
              </svg>
            </button>
            <button id="btn-list" class="toggle-btn w-7 h-7 rounded-md flex items-center justify-center text-gray-500 cursor-pointer" title="Vue liste">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <line x1="5" y1="4" x2="14" y2="4"/><line x1="5" y1="8" x2="14" y2="8"/><line x1="5" y1="12" x2="14" y2="12"/>
                <circle cx="2" cy="4" r="1" fill="currentColor" stroke="none"/>
                <circle cx="2" cy="8" r="1" fill="currentColor" stroke="none"/>
                <circle cx="2" cy="12" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Grid -->
  <main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
    <div id="grid" class="grid grid-cols-1 md:grid-cols-3 gap-5">

      {cases.map(c => {
        const industry = c.subtitle.includes('—') ? c.subtitle.split('—')[1].trim() : '';
        const kpi = c.kpis[0];
        return (
          <a href={`/case-studies/${c.slug}`}
             class="case-card bg-white rounded-2xl overflow-hidden flex flex-col shadow-sm"
             data-sector={c.sector}
             data-industry={industry}
             data-slug={c.slug}>
            <!-- Image -->
            <div class="card-img relative overflow-hidden" style="aspect-ratio:2/1; flex-shrink:0;">
              <img src={c.image} alt={c.title} class="w-full h-full object-cover block" />
              <div class="absolute bottom-3 left-3 flex gap-1.5 flex-wrap">
                <span class="text-xs font-bold px-2.5 py-1 rounded-full text-white"
                      style={`background-color:${SECTOR_COLORS[c.sector].hex};`}>
                  {c.sector}
                </span>
                {industry && (
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full text-gray-700"
                        style="background:rgba(255,255,255,0.92); backdrop-filter:blur(4px);">
                    {industryLabels[industry] ?? industry}
                  </span>
                )}
              </div>
            </div>
            <!-- Content -->
            <div class="p-4 flex flex-col flex-1">
              <div class="card-titleblock flex-1 mb-2">
                {c.client && (
                  <p class="text-xs font-bold uppercase tracking-wide mb-1" style={`color:${SECTOR_COLORS[c.sector].hex};`}>{c.client}</p>
                )}
                <h2 class="card-title text-base font-bold text-gray-900 leading-snug">{c.title}</h2>
              </div>
              <hr class="border-gray-100 mb-2" />
              <div class="kpi-group">
                <p class="text-2xl font-extrabold leading-none mb-1" style={`color:${SECTOR_COLORS[c.sector].hex};`}>
                  {kpi.value}
                </p>
                <p class="kpi-label text-sm text-gray-500 leading-relaxed mb-3">{kpi.label}</p>
              </div>
              <span class="card-cta inline-flex items-center gap-1 text-sm font-semibold" style={`color:${SECTOR_COLORS[c.sector].hex};`}>
                Voir le cas →
              </span>
            </div>
          </a>
        );
      })}

      <!-- État vide -->
      <div id="empty-state" style="display:none"
           class="col-span-3 py-20 flex flex-col items-center text-center">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" class="mb-4">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <p class="text-base font-medium text-gray-400">Aucune réalisation pour cette combinaison de filtres.</p>
        <button id="btn-reset-filters" class="mt-3 text-sm font-medium text-indigo-600 hover:underline cursor-pointer">
          Réinitialiser les filtres
        </button>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const sectorColors: Record<string, string> = {
    Product: '#6d28d9', AI: '#0891b2', Data: '#059669', Design: '#db2777',
  };

  let activeSector = 'all';
  let activeIndustry = 'all';

  function applyFilters() {
    let visibleCount = 0;

    document.querySelectorAll<HTMLElement>('.case-card').forEach(card => {
      const sectorMatch = activeSector === 'all' || card.dataset.sector === activeSector;
      const industryMatch = activeIndustry === 'all' || card.dataset.industry === activeIndustry;
      const show = sectorMatch && industryMatch;
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    // Compteur dynamique
    const counter = document.getElementById('result-count');
    if (counter) counter.textContent = `${visibleCount} résultat${visibleCount > 1 ? 's' : ''}`;

    // État vide
    const emptyState = document.getElementById('empty-state');
    if (emptyState) emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';

    // "Tous" Expertise : actif si activeSector === 'all'
    const btnTousSector = document.getElementById('btn-tous-sector') as HTMLElement;
    const sectorAllActive = activeSector === 'all';
    btnTousSector.style.backgroundColor = sectorAllActive ? '#111827' : '#fff';
    btnTousSector.style.color = sectorAllActive ? '#fff' : '#374151';
    btnTousSector.style.borderColor = sectorAllActive ? '#111827' : '#e5e7eb';

    // "Tous" Secteur : actif si activeIndustry === 'all'
    const btnTousIndustry = document.getElementById('btn-tous-industry') as HTMLElement;
    const industryAllActive = activeIndustry === 'all';
    btnTousIndustry.style.backgroundColor = industryAllActive ? '#111827' : '#fff';
    btnTousIndustry.style.color = industryAllActive ? '#fff' : '#374151';
    btnTousIndustry.style.borderColor = industryAllActive ? '#111827' : '#e5e7eb';

    // Boutons secteurs — border toujours colorée, bg change selon l'état
    document.querySelectorAll<HTMLElement>('.filter-btn-sector').forEach(btn => {
      const key = btn.dataset.filter!;
      const isActive = key === activeSector;
      btn.style.backgroundColor = isActive ? sectorColors[key] : '#fff';
      btn.style.color = isActive ? '#fff' : sectorColors[key];
      btn.style.borderColor = sectorColors[key];
    });

    // Boutons industries
    document.querySelectorAll<HTMLElement>('.filter-btn-industry').forEach(btn => {
      const isActive = btn.dataset.filter === activeIndustry;
      btn.style.backgroundColor = isActive ? '#374151' : '#fff';
      btn.style.color = isActive ? '#fff' : '#6b7280';
      btn.style.borderColor = isActive ? '#374151' : '#e5e7eb';
    });
  }

  // "Tous" Expertise : réinitialise uniquement le secteur
  document.getElementById('btn-tous-sector')!.addEventListener('click', () => {
    activeSector = 'all';
    applyFilters();
  });

  // "Tous" Secteur : réinitialise uniquement l'industrie
  document.getElementById('btn-tous-industry')!.addEventListener('click', () => {
    activeIndustry = 'all';
    applyFilters();
  });

  // Boutons secteurs (sélection unique)
  document.querySelectorAll<HTMLElement>('.filter-btn-sector').forEach(btn => {
    btn.addEventListener('click', () => {
      activeSector = btn.dataset.filter!;
      applyFilters();
    });
  });

  // Boutons industries (toggle : re-cliquer désélectionne)
  document.querySelectorAll<HTMLElement>('.filter-btn-industry').forEach(btn => {
    btn.addEventListener('click', () => {
      activeIndustry = activeIndustry === btn.dataset.filter ? 'all' : btn.dataset.filter!;
      applyFilters();
    });
  });

  // Reset depuis l'état vide
  document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
    activeSector = 'all';
    activeIndustry = 'all';
    applyFilters();
  });

  // Toggle grille / liste
  const grid = document.getElementById('grid')!;
  document.getElementById('btn-grid')!.addEventListener('click', () => {
    grid.classList.remove('list-view');
    document.getElementById('btn-grid')!.classList.add('active');
    document.getElementById('btn-list')!.classList.remove('active');
  });
  document.getElementById('btn-list')!.addEventListener('click', () => {
    grid.classList.add('list-view');
    document.getElementById('btn-list')!.classList.add('active');
    document.getElementById('btn-grid')!.classList.remove('active');
  });

  // ── Analytics (beacon léger, cookieless, fire-and-forget) ──
  function track(payload: Record<string, string>) {
    try {
      const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
      navigator.sendBeacon('/api/track', blob);
    } catch { /* silencieux : ne jamais gêner l'utilisateur */ }
  }
  track({ type: 'view' });
  document.querySelectorAll<HTMLElement>('.case-card').forEach((card) => {
    card.addEventListener('click', () => {
      const slug = card.dataset.slug;
      if (slug) track({ type: 'click', slug });
    });
  });
</script>
