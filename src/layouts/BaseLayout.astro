---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Nos Réalisations — Wivoo' } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="shortcut icon" href="https://cdn.prod.website-files.com/64f8703aba9a3b126e920e3a/6876156471ddbe66006c7b12_Wivoo%20RGB%20Blue%20Favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="https://cdn.prod.website-files.com/64f8703aba9a3b126e920e3a/6876158951fec8ab12c749b0_Wivoo%20RGB%20Blue%20Webclip.png" />
</head>
<body class="bg-white text-gray-900 font-sans">
  <slot />
</body>
</html>
